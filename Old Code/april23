  // Navigation methods

void turn(float desiredAngle) {
  float turnDistance;
  update();
  turnDistance = getShortestTurn(currentTheta, desiredAngle);

  float smallAngle = .01; // small error for turning
  float largeAngle = .65; // larger error for turning

  // Turns left if the shortest distance is left, otherwise turns right
  
  if (turnDistance > 0) {
    while (abs(desiredAngle - currentTheta) > largeAngle) {
      H2GoSetLeftPWM(fastSpeed);
      H2GoSetRightPWM(-fastSpeed);
      currentTheta = Enes100.getTheta();
    }
    H2GoStopMotors();
     delay(100);
     Enes100.println("Stopped fast turning");
    // Slowing down as we approach the desired angle
    while (abs(desiredAngle - currentTheta) > smallAngle) {
      H2GoSetLeftPWM(slowSpeed);
      H2GoSetRightPWM(-slowSpeed);
      currentTheta = Enes100.getTheta();
    }
    H2GoStopMotors();
    delay(100);
    Enes100.println("Stopped slow turning");
  } else {
    while (abs(desiredAngle - currentTheta) > largeAngle) {
      H2GoSetLeftPWM(-fastSpeed);
      H2GoSetRightPWM(fastSpeed);
      currentTheta = Enes100.getTheta();
    }
    H2GoStopMotors();
     delay(100);
    // Slowing down as we approach the desired angle
    while (abs(desiredAngle - currentTheta) > smallAngle) {
      H2GoSetLeftPWM(-slowSpeed);
      H2GoSetRightPWM(slowSpeed);
      currentTheta = Enes100.getTheta();
    }
    H2GoStopMotors();
     delay(100);
  }
}

