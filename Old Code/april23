void measureWater() {
  
  long duration;
  long cm;
  long waterDistance;

  pinMode(PIN_US_MISSION_TRIG, OUTPUT);
  pinMode(PIN_US_MISSION_ECHO, INPUT);

  // Short low pulse
  digitalWrite(PIN_US_MISSION_TRIG, LOW);
  delayMicroseconds(5);
  digitalWrite(PIN_US_MISSION_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(PIN_US_MISSION_TRIG, LOW);

  // Read signal
  duration = pulseIn(PIN_US_MISSION_ECHO, HIGH);
  Enes100.println(duration);

  cm = (duration / 2.0) / 29.1;  // Convert to cm

  Enes100.println("cm is ");
  // Enes100.println(cm);

  // 9.35 distance
  waterDistance = 8 - cm;

  int range20 = abs(2.0 - waterDistance);
  int range30 = abs(3.0 - waterDistance);
  int range40 = abs(4.0 - waterDistance);

  // Serial.println("Working");
  if (range20 < range30 && range20 < range40) {
    Enes100.mission(DEPTH, 20);
    Serial.println("20");
  } else if (range30 < range20 && range30 < range40) {
    Enes100.mission(DEPTH, 30);
    Serial.println("30");
  } else {
    Enes100.mission(DEPTH, 40);
    Serial.println("40");
  }
}

