void reverseY(float distance) {
  // Reverses in y-direction by distance

  float desiredY;
  float distanceRange = .05;

  // Determines whether we want to reverse to the top or the bottom of the map
  if (currentTheta > 0) {
    desiredY = currentY - distance;
    // Reversing to the desired direction
    while (abs(currentY - desiredY) > distanceRange) {
      setBothPWM(-FAST_SPEED);
      update();
    }

    stopMotors();
  } else {
    desiredY = currentY + distance;
    // Reversing to the desired direction
    while (abs(currentY - desiredY) > distanceRange) {
      setBothPWM(-FAST_SPEED);
      update();
    }

    stopMotors();
  }
}

float getShortestTurn(float currentAngle, float desiredAngle) {
  // Difference between current angle and desired angle (distance in radians we need to turn)
  float angleDifference;
  angleDifference = desiredAngle - currentAngle;

  // Determines turn direction

  if (angleDifference > PI) {  // Difference is larger than a full half-turn, subtract full turn to get shortest turn.
    angleDifference = angleDifference - (2.0 * PI);
  } else if (angleDifference <= (-1 * PI)) {  // Difference is larger than a full half-turn, add full turn to get shortest turn. (other direction)
    angleDifference = angleDifference + (2.0 * PI);
  }

  // Returns distance in radians that needs to be travelled, negative is
  return angleDifference;
}

// Motor methods

void setMotorPWM(int motorId, int pwm) {

  int forward_pin;
  int reverse_pin;
  int speed_pin;

  // Edge cases if pwm exceeds 255 or -255
  if (pwm > 255) {
    pwm = 255;
  } else if (pwm < -255) {
    pwm = -255;
  }

  // Verify motorId
  if (motorId < 1 || motorId > 2) {
    return;
  }

  // Get pins to use
  if (motorId == 1) {
    forward_pin = PIN_MOTOR_1_FORWARD;
    reverse_pin = PIN_MOTOR_1_REVERSE;
    speed_pin = PIN_MOTOR_1_SPEED;
  } else if (motorId == 2) {
    forward_pin = PIN_MOTOR_2_FORWARD;
    reverse_pin = PIN_MOTOR_2_REVERSE;
    speed_pin = PIN_MOTOR_2_SPEED;
  }

  // Set pin PWM and GND
  if (pwm >= 0) {
    digitalWrite(forward_pin, HIGH);
    digitalWrite(reverse_pin, LOW);
    analogWrite(speed_pin, abs(pwm));
  } else {
    digitalWrite(forward_pin, LOW);
    digitalWrite(reverse_pin, HIGH);
    analogWrite(speed_pin, abs(pwm));
  }
}

void stopMotors() {
  setMotorPWM(1, 0);
  setMotorPWM(2, 0);
}

void setBothPWM(int pwm) {
  setRightPWM(pwm);
  setLeftPWM(pwm);
}

void setRightPWM(int pwm) {
  setMotorPWM(1, pwm);
}

void setLeftPWM(int pwm) {
  // Fraction of pwm to add to left motor to account for lower speed
  float offset = .27;
  setMotorPWM(2, pwm + (offset * pwm));
}

