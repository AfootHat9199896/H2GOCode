void measureWater() {

  const long sensorHeight = 75;

  long duration;
  long mm;
  long waterDistance;

  // Repeats pin assignment (this can probably be taken out)
  pinMode(PIN_US_MISSION_TRIG, OUTPUT);
  pinMode(PIN_US_MISSION_ECHO, INPUT);

  // Pulses
  digitalWrite(PIN_US_MISSION_TRIG, LOW);
  delayMicroseconds(5);
  digitalWrite(PIN_US_MISSION_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(PIN_US_MISSION_TRIG, LOW);

  // Read signal
  duration = pulseIn(PIN_US_MISSION_ECHO, HIGH);
  Enes100.println(duration);

  // Convert to cm
  mm = ((duration / 2.0) / 29.1) * 10;

  Enes100.print("Distance in millimeters is ");
  Enes100.println(mm);

  // Subtracts sensor to water distance from sensor to bowl distance
  waterDistance = sensorHeight - mm;

  // Compares differences between water distance and 20, 30, 40 mm
  int range20 = abs(20 - waterDistance);
  int range30 = abs(30 - waterDistance);
  int range40 = abs(40 - waterDistance);

  if (range20 < range30 && range20 < range40) {
    Enes100.mission(DEPTH, 20);
    Serial.println("Water depth is 20 mm.");
    Enes100.println("Water depth is 30 mm.");
  } else if (range30 < range20 && range30 < range40) {
    Enes100.mission(DEPTH, 30);
    Serial.println("Water depth is 30 mm.");
    Enes100.println("Water depth is 30 mm.");
  } else {
    Enes100.mission(DEPTH, 40);
    Serial.println("Water depth is 40 mm.");
    Enes100.println("Water depth is 40 mm.");
  }
}

void checkPollution() {
  // Might need to import ML model?
  int prediction = Enes100.MLGetPrediction(1);

  // Prediction = 0 will be unpolluted, prediction = 1 will be polluted
  if (prediction == 0) {
    Enes100.mission(WATER_TYPE, FRESH_UNPOLLUTED);
  } else {
    Enes100.mission(WATER_TYPE, FRESH_POLLUTED);
  }
}

void getSample() {
  bool rackMoving;
  rackMoving = true;

  if (rackMoving) {

    // Moves rack and pinion down when top limit switch is not pressed
    while (digitalRead(TOP_SW) != HIGH) {
      analogWrite(PIN_ENA, RACK_SPEED);
      digitalWrite(PIN_RACK_1, HIGH);
      digitalWrite(PIN_RACK_2, LOW);
    }

    // Top limit switch is pressed, brakes motors
    digitalWrite(PIN_RACK_1, LOW);
    digitalWrite(PIN_RACK_2, LOW);
    // Waits for water to be absorbed in diaper
    delay(WATER_ABSORB_TIME);

    // Moves rack and pinion up when bottom limit switch is not pressed
    while (digitalRead(BOTTOM_SW) != HIGH) {  //moves rack and pinion up while bottom limit switch isnt pressed
      analogWrite(PIN_ENA, RACK_SPEED);
      digitalWrite(PIN_RACK_1, LOW);
      digitalWrite(PIN_RACK_2, HIGH);
    }

    // Bottom limit switch is pressed, brakes motors
    digitalWrite(PIN_RACK_1, LOW);
    digitalWrite(PIN_RACK_2, LOW);
    rackMoving = false;
  }
}

void lowerRack() {

  // Moves rack and pinion down when top limit switch is not pressed
  while (digitalRead(TOP_SW) != HIGH) {
    analogWrite(PIN_ENA, RACK_SPEED);
    digitalWrite(PIN_RACK_1, HIGH);
    digitalWrite(PIN_RACK_2, LOW);
  }

  // Top limit switch is pressed, brakes motors
  digitalWrite(PIN_RACK_1, LOW);
  digitalWrite(PIN_RACK_2, LOW);
}

// Finds pollutants using photoResistor
void findPollutants() {

  int resistorAVG = 0;

  for (int i = 0; i < PR_LOOP; i++){
    resistorAVG += analogRead(PIN_PR_ANALOG_READ);
    delay(200);
  }

  resistorAVG = resistorAVG / PR_LOOP;

  if (resistorAVG > COLOR_THRESHOLD) {
    // I have it print to Enes100 and serial so you can test it when plugged in type 
    Enes100.print("Has pollutants, photoresistor average value: ");
    Enes100.println(resistorAVG);
    Serial.print("Has pollutants, photoresistor average value: ");
    Serial.println(resistorAVG);
     Enes100.mission(WATER_TYPE, FRESH_POLLUTED);

  } else {
    Enes100.print("Unpolluted, photoresistor average value: ");
    Enes100.println(resistorAVG);
    Serial.print("Unpolluted, photoresistor average value: ");
    Serial.println(resistorAVG);
     Enes100.mission(WATER_TYPE, FRESH_UNPOLLUTED);

  }
}
