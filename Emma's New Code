void update() {
  // Updates angle, x, and y
  currentTheta = Enes100.getTheta();
  currentX = Enes100.getX();
  currentY = Enes100.getY();
}

// Turning methods

void turn(float desiredAngle) {

  float turnDistance, deltaCurrentDesired1, deltaCurrentDesired2;
  update();
  turnDistance = getShortestTurn(currentTheta, desiredAngle);

  // Turns left if the shortest distance is left, otherwise turns right


  if (turnDistance > 0) {  // Making a counter-clockwise turn

    while (abs(desiredAngle - currentTheta) > LARGE_ANGLE_RANGE) {  // While outside of large angle range
      spinCCW(FAST_SPEED);
      update();
    }

    // Stop motors and wait
    Enes100.println("Within large angle range.");
    stopMotors();
    delay(BUFFER);
    update();

    while (abs(desiredAngle - currentTheta) > SMALL_ANGLE_RANGE) {  // While outside of small angle range
      deltaCurrentDesired1 = abs(desiredAngle - currentTheta);
      spinCCW(SLOW_SPEED);
      delay(TURN_BUFFER);
      stopMotors();
      delay(TURN_BUFFER);
      update();
      deltaCurrentDesired2 = abs(desiredAngle - currentTheta);
      if (deltaCurrentDesired2 > deltaCurrentDesired1) {
        break;
      }
    }
    stopMotors();
    if (abs(desiredAngle - currentTheta) > SMALL_ANGLE_RANGE) {
      turn(desiredAngle);
    }
    // Stop motors and wait
    delay(BUFFER / 4);
    Enes100.println("Within small angle range.");

  } else {  // Making a clockwise turn

    while (abs(desiredAngle - currentTheta) > LARGE_ANGLE_RANGE) {  // While outside of large angle range
      spinCW(FAST_SPEED);
      update();
    }

    // Stop motors and wait
    stopMotors();
    delay(BUFFER / 4);
    Enes100.println("Within large angle range.");
    update();

    // Slowing down as we approach the desired angle
    while (abs(desiredAngle - currentTheta) > SMALL_ANGLE_RANGE) {  // While outside of small angle range
      deltaCurrentDesired1 = abs(desiredAngle - currentTheta);
      spinCW(SLOW_SPEED);
      delay(TURN_BUFFER);
      stopMotors();
      delay(TURN_BUFFER);
      update();
      deltaCurrentDesired2 = abs(desiredAngle - currentTheta);
      if (deltaCurrentDesired2 > deltaCurrentDesired1) {
        break;
      }
    }
    stopMotors();
    // Stop motors and wait
    if (abs(desiredAngle - currentTheta) > SMALL_ANGLE_RANGE) {
      turn(desiredAngle);
    }
    delay(100);
    Enes100.println("Within small angle range.");
  }
}

void spinCCW(int speed) {
  setLeftPWM(-speed);
  setRightPWM(speed);
}

void spinCW(int speed) {
  setLeftPWM(speed);
  setRightPWM(-speed);
}

void leftTurn(float desiredAngle) {
  float turnDistance;
  update();
  turnDistance = getShortestTurn(currentTheta, desiredAngle);

  if (abs(0 - currentTheta) < .05) {
    return;
  }
  // Slowing down as we approach the desired angle
  while (abs(desiredAngle - currentTheta) > .08) {
    update();
    if (abs(0 - currentTheta) < .05) {
      return;
    }
    setLeftPWM(SLOW_SPEED + 10);
    delay(TURN_BUFFER);
    stopMotors();
    delay(TURN_BUFFER);
    update();
  }
  stopMotors();
  delay(BUFFER / 2);

}

// Moving methods

void goToY(float desiredY) {

  // Within how many meters the OTV will reach site
  update();
  float desiredTheta;
  // Determines whether the desired Y is above or below the current y, turns appropriately

  if (desiredY > currentY) {
    Enes100.println("Turn north.");
    desiredTheta = HALF_PI;
    turn(HALF_PI);
  } else {
    Enes100.println("Turn south.");
    desiredTheta = (-1 * HALF_PI);
    turn(-1 * HALF_PI);
  }

  update();

  // Moves towards the desired y value until it gets close
  while (abs(desiredY - currentY) > DISTANCE_RANGE) {
    setBothPWM(FAST_SPEED);
    update();

    if (abs(currentTheta - desiredTheta) > MOVING_RANGE) {
      turn(desiredTheta);
    }
  }

  // Stop when within range
  stopMotors();
}

void goToX(float desiredX) {

  // Within how many meters the OTV will reach site

  update();
  float desiredTheta;
  // Determines whether the desired x is to the right or left of current x, turns appropriately
  if (desiredX > currentX) {
    Enes100.println("Turn east.");
    desiredTheta = 0;
    turn(0);
  } else {
    Enes100.println("Turn west.");
    desiredTheta = PI;
    turn(PI);
  }

  // Moves towards a desired x value until it gets close
  while (abs(desiredX - currentX) > DISTANCE_RANGE) {
    setBothPWM(FAST_SPEED);
    update();

    if (abs(currentTheta - desiredTheta) > MOVING_RANGE) {
      turn(desiredTheta);
    }
  }


  // Stop when within range
  stopMotors();
}

void reverseY(float distance) {
  // Reverses in y-direction by distance

  float desiredY;
  float distanceRange = .05;

  // Determines whether we want to reverse to the top or the bottom of the map
  if (currentTheta > 0) {
    desiredY = currentY - distance;
    // Reversing to the desired direction
    while (abs(currentY - desiredY) > distanceRange) {
      setBothPWM(-FAST_SPEED);
      update();
    }

    stopMotors();
  } else {
    desiredY = currentY + distance;
    // Reversing to the desired direction
    while (abs(currentY - desiredY) > distanceRange) {
      setBothPWM(-FAST_SPEED);
      update();
    }

    stopMotors();
  }
}

float getShortestTurn(float currentAngle, float desiredAngle) {
  // Difference between current angle and desired angle (distance in radians we need to turn)
  float angleDifference;
  angleDifference = desiredAngle - currentAngle;

  // Determines turn direction

  if (angleDifference > PI) {  // Difference is larger than a full half-turn, subtract full turn to get shortest turn.
    angleDifference = angleDifference - (2.0 * PI);
  } else if (angleDifference <= (-1 * PI)) {  // Difference is larger than a full half-turn, add full turn to get shortest turn. (other direction)
    angleDifference = angleDifference + (2.0 * PI);
  }

  // Returns distance in radians that needs to be travelled, negative is
  return angleDifference;
}

// Motor methods

void setMotorPWM(int motorId, int pwm) {

  int forward_pin;
  int reverse_pin;
  int speed_pin;

  // Edge cases if pwm exceeds 255 or -255
  if (pwm > 255) {
    pwm = 255;
  } else if (pwm < -255) {
    pwm = -255;
  }

  // Verify motorId
  if (motorId < 1 || motorId > 2) {
    return;
  }

  // Get pins to use
  if (motorId == 1) {
    forward_pin = PIN_MOTOR_1_FORWARD;
    reverse_pin = PIN_MOTOR_1_REVERSE;
    speed_pin = PIN_MOTOR_1_SPEED;
  } else if (motorId == 2) {
    forward_pin = PIN_MOTOR_2_FORWARD;
    reverse_pin = PIN_MOTOR_2_REVERSE;
    speed_pin = PIN_MOTOR_2_SPEED;
  }

  // Set pin PWM and GND
  if (pwm >= 0) {
    digitalWrite(forward_pin, HIGH);
    digitalWrite(reverse_pin, LOW);
    analogWrite(speed_pin, abs(pwm));
  } else {
    digitalWrite(forward_pin, LOW);
    digitalWrite(reverse_pin, HIGH);
    analogWrite(speed_pin, abs(pwm));
  }
}

void stopMotors() {
  setMotorPWM(1, 0);
  setMotorPWM(2, 0);
}

void setBothPWM(int pwm) {
  setRightPWM(pwm);
  setLeftPWM(pwm);
}

void setRightPWM(int pwm) {
  setMotorPWM(1, pwm);
}

void setLeftPWM(int pwm) {
  // Fraction of pwm to add to left motor to account for lower speed
  float offset = .27;
  setMotorPWM(2, pwm + (offset * pwm));
}

