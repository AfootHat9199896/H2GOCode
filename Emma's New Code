  for (int i = 0; i < 20; i++) {
    // Pulses
    digitalWrite(PIN_US_FRONT_TRIG, LOW);
    delayMicroseconds(5);
    digitalWrite(PIN_US_FRONT_TRIG, HIGH);
    delayMicroseconds(10);
    digitalWrite(PIN_US_FRONT_TRIG, LOW);

    // Read signal
    duration = pulseIn(PIN_US_FRONT_ECHO, HIGH);
    Enes100.println(duration);

    // Convert to cm
    cm = ((duration / 2.0) / 29.1);

    // Adds to average variable to be divided after the loop ends
    averageDistance += cm;
  }

  cm = averageDistance/20;

  Enes100.print("Distance in cm is ");
  Enes100.println(cm);

  if (cm < 65) {
    return false;
  } else {
    return true;
  }
}
